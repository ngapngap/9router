# 9Router (SaaS fork) — environment contract
# File này phản ánh usage thực tế trong codebase hiện tại.

# ──────────────────────────────────────
# SaaS — PostgreSQL New-API (chỉ đọc / SELECT)
# ──────────────────────────────────────
# 9Router không tạo hay migrate Postgres; dùng DB có sẵn của New-API.
# Nên cấp user DB chỉ quyền SELECT trên bảng cần (users, tokens).
SAAS_ENABLED=true
# SAAS_DATABASE_URL=postgresql://readonly_user:password@vps-host-or-docker-network:5432/new_api_db?sslmode=prefer
# SAAS_JWT_EXPIRES_IN=7d

# ──────────────────────────────────────
# SaaS — Admin & CLI
# ──────────────────────────────────────
# Comma-separated users.id được coi là admin bất kể role
# SAAS_ADMIN_USER_IDS=
# Role values cho computeIsAdmin (CSV, default "10,100")
# SAAS_ADMIN_ROLE_VALUES=10,100
# Fallback admin user id — opt-in only, numeric only
# SAAS_ADMIN_FALLBACK_USER_ID=
# Bypass cookie JWT trên /api/* (non-public) khi SAAS_ENABLED — match header x-9r-cli-token
# CLI_TOKEN_9R=
# Override Ramclouds preset base URL (default https://ramclouds.me/v1)
# SAAS_RAMCLOUDS_BASE_URL=https://ramclouds.me/v1

# ──────────────────────────────────────
# Required
# ──────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-secret
INITIAL_PASSWORD=change-me
DATA_DIR=/var/lib/9router

# ──────────────────────────────────────
# Network & Port
# ──────────────────────────────────────
# Port 20130 (SaaS fork) — khác 20128 của 9router gốc
PORT=20130
NODE_ENV=production

# ──────────────────────────────────────
# Security
# ──────────────────────────────────────
API_KEY_SECRET=endpoint-proxy-api-key-secret
MACHINE_ID_SALT=endpoint-proxy-salt
AUTH_COOKIE_SECURE=false
# Secret để gọi /api/shutdown an toàn (không set = shutdown API bị vô hiệu)
# SHUTDOWN_SECRET=
# API key cho MITM proxy handler
# ROUTER_API_KEY=

# ──────────────────────────────────────
# Observability & Logging
# ──────────────────────────────────────
OBSERVABILITY_ENABLED=true
# OBSERVABILITY_MAX_RECORDS=10000
# OBSERVABILITY_BATCH_SIZE=50
# OBSERVABILITY_FLUSH_INTERVAL_MS=5000
# OBSERVABILITY_MAX_JSON_SIZE=64
ENABLE_REQUEST_LOGS=false
ENABLE_TRANSLATOR=false

# ──────────────────────────────────────
# Cloud Sync
# ──────────────────────────────────────
# Phải trỏ tới instance đang chạy để /api/sync/cloud hoạt động
BASE_URL=http://localhost:20130
CLOUD_URL=https://9router.com
NEXT_PUBLIC_BASE_URL=http://localhost:20130
NEXT_PUBLIC_CLOUD_URL=https://9router.com

# ──────────────────────────────────────
# Outbound Proxy (cho upstream provider calls)
# ──────────────────────────────────────
# Lowercase variants also supported: http_proxy, https_proxy, all_proxy, no_proxy
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# ALL_PROXY=socks5://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1

# ──────────────────────────────────────
# Tunnel (Cloudflare / Tailscale)
# ──────────────────────────────────────
# TUNNEL_WORKER_URL=https://9router.com
# CLOUDFLARED_PROTOCOL=http2
# TUNNEL_TRANSPORT_PROTOCOL=http2
